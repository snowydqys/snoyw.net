---
import Layout from "../layouts/Layout.astro";
import SocialCard from "../components/SocialCard.astro";
import HorizontalSeparator from "../components/HorizontalSeparator.astro";

import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Badge, { ActivityLevel } from "../components/Badge.astro";

const oshiMarks = [
  {
    name: "ShiroNekoNya",
    href: "/oshis#ShiroNekoNya",
    title: "Cathusbands!",
    icons: ["twemoji:white-heart", "twemoji:paw-prints"],
  },
  {
    name: "FUWAMOCO",
    href: "/oshis#FUWAMOCO",
    title: "Ruffians!",
    icons: [
      "twemoji:paw-prints",
      "twemoji:blue-heart",
      "twemoji:pink-heart",
      "twemoji:paw-prints",
    ],
  },
  {
    name: "Fallenshadow",
    href: "/oshis#Fallenshadow",
    title: "Shondophrenics!",
    icons: [
      "twemoji:ribbon",
      "twemoji:chocolate-bar",
      "twemoji:kitchen-knife",
    ],
  },
  {
    name: "Nekomata Okayu",
    href: "/oshis#NekomataOkayu",
    title: "Onigiryaa!",
    icons: ["twemoji:rice-ball"],
  },
];
---

<Layout
  title="snoyw / snowydqys"
  description="hii im snoyw, an average anime degenerate and vtuber enthusiast!"
  url="https://snoyw.net"
>
  <main class="w-full flex flex-col gap-4 items-center text-white">
    <Image
      src="https://cdn.snoyw.net/snoyw.net/pfps/fuwawa_icomochi_kryomel_pfp.png"
      alt="Fuwawa Avatar; art by Icomochi, edit by Kryomel"
      class="w-48 h-48 lg:w-64 lg:h-64 rounded-full mt-8 avatar"
      title="Fuwawa Avatar; art by Icomochi, edit by Kryomel"
      width={256}
      height={256}
    />
    <div class="flex flex-col gap-1 items-center">
      <h1 class="text-3xl lg:text-4xl font-bold fuwamoco-text">snowydqys</h1>
      <h2
        id="sub-heading"
        class="text-sm lg:text-base italic opacity-60"
        title="Different ways of calling me"
      >
        mostly goes by "snoyw"
      </h2>
    </div>
    <div
      class="oshi-scroller flex items-center overflow-hidden w-64 max-w-[85vw] h-8"
    >
      {
        Array.from({ length: 3 }).map((_, groupIndex) => (
          <div
            class="oshi-group flex items-center gap-2 pr-2 shrink-0"
          >
            {oshiMarks.map((oshi) => (
              <>
                <a
                  href={oshi.href}
                >
                  <div
                    class="flex items-center justify-center h-6 gap-0.5 hover:animate-pulse"
                    title={oshi.title}
                  >
                    {oshi.icons.map((icon) => (
                      <Icon
                        name={icon as any}
                        class="inline animate-wiggle"
                        size={24}
                      />
                    ))}
                  </div>
                </a>

                <div class="flex items-center justify-center rounded-lg opacity-60 h-2">
                  <Icon name="twemoji:snowflake" class="inline" size={8} />
                </div>
              </>
            ))}
          </div>
        ))
      }
    </div>
    <p
      id="main-text"
      class="text-wrap max-w-4xl text-center text-base lg:text-lg"
    >
      hii im snoyw, an average anime degenerate and vtuber enthusiast!
      <br />
      i like to watch anime, play casual games, and <span class="fuwamoco-text bau-bau">BAU BAU</span> in my free time.
      <br />
      i also watch vtubers, with my kami oshi being <a
        href="https://u.snoyw.net/fwmc"
        class="fuwamoco-text fuwamoco-underline">FUWAMOCO</a
      >, but i have <a href="/oshis" class="underline">other oshis too</a>!
      <br />
      feel free to contact me and say hi!! <span class="fuwamoco-text bau-bau">BAU BAU</span>!!
      <Icon name="twemoji:paw-prints" class="inline" size={24} />
    </p>
    <div class="flex gap-2 flex-wrap justify-center items-center">
      <Badge
        activityLevel={ActivityLevel.High}
        className="flex justify-center items-center gap-1"
        muted={true}
      >
        <Badge activityLevel={ActivityLevel.High} />
        {ActivityLevel.High}
      </Badge>
      <Badge
        activityLevel={ActivityLevel.Medium}
        className="flex justify-center items-center gap-1"
        muted={true}
      >
        <Badge activityLevel={ActivityLevel.Medium} />
        {ActivityLevel.Medium}
      </Badge>
      <Badge
        activityLevel={ActivityLevel.Low}
        className="flex justify-center items-center gap-1"
        muted={true}
      >
        <Badge activityLevel={ActivityLevel.Low} />
        {ActivityLevel.Low}
      </Badge>
    </div>
    <ul role="list" class="flex flex-col gap-4">
      <HorizontalSeparator>Main Contacts</HorizontalSeparator>

      <SocialCard
        href="https://u.snoyw.net/discord"
        title="Discord - @snowydqys"
        body="my discord account, where you can feel free to add me as a friend!"
        icon="fa6-brands:discord"
        customAccent="88,101,242"
        customAccentLight="160,167,248"
        activityLevel={ActivityLevel.High}
      />
      <SocialCard
        href="mailto:contact@snoyw.net"
        title="Email - contact@snoyw.net"
        body="you can also contact me via email, if you prefer"
        icon="mdi:email"
        activityLevel={ActivityLevel.High}
      />
      <SocialCard
        href="https://u.snoyw.net/matrix"
        title="Matrix - @snoyw:snoyw.net"
        body="still getting used to this but you can also contact me here if you want"
        icon="ph:matrix-logo"
        customAccent="0, 0, 0"
        customAccentLight="125, 125, 125"
        activityLevel={ActivityLevel.Medium}
      />

      <HorizontalSeparator>Other Socials</HorizontalSeparator>

      <SocialCard
        href="https://u.snoyw.net/steam"
        title="Steam - snowydqys"
        body="i play games (you are not allowed to judge me for my obsession with the NEKOPARA franchise)"
        icon="fa6-brands:steam"
        customAccent="0,173,238"
        customAccentLight="179,235,255"
        activityLevel={ActivityLevel.High}
      />
      <SocialCard
        href="https://u.snoyw.net/youtube"
        title="YouTube - @snowydqys"
        body="i don't upload but i use this to watch vtuber clips and stuff"
        icon="fa6-brands:youtube"
        customAccent="255,0,0"
        customAccentLight="200,153,153"
        activityLevel={ActivityLevel.High}
      />
      <SocialCard
        href="https://u.snoyw.net/anilist"
        title="AniList - @snowydqys"
        body="where i keep track of the anime i've watched (mostly automated)"
        icon="simple-icons:anilist"
        customAccent="2,169,255"
        customAccentLight="200,245,255"
        activityLevel={ActivityLevel.Medium}
      />
      <SocialCard
        href="https://u.snoyw.net/mfc"
        title="MyFigureCollection - @snowydqys"
        body="see how much money i waste on anime figures and other merchandise"
        icon="mfc"
        customAccent="89,166,84"
        customAccentLight="178,247,173"
        activityLevel={ActivityLevel.Medium}
      />
      <SocialCard
        href="https://u.snoyw.net/reddit"
        title="Reddit - @snowyniqhts"
        body="i mostly lurk and upvote stuff. not very active here. (had to go with niqhts cause dqys was taken)"
        icon="fa6-brands:reddit-alien"
        customAccent="255,69,0"
        customAccentLight="255,210,194"
        activityLevel={ActivityLevel.Medium}
      />
      <SocialCard
        href="https://u.snoyw.net/twitter"
        title="X - @snowydqys"
        body="my X (formerly Twitter) account where i mostly like and retweet vtuber stuff"
        icon="fa6-brands:x-twitter"
        customAccent="0,0,0"
        customAccentLight="125,125,125"
        activityLevel={ActivityLevel.Low}
      />
      <SocialCard
        href="https://u.snoyw.net/bsky"
        title="Bluesky - @snoyw.net"
        body="my bluesky account, dont use this anymore to be honest. also used it to like and retweet vtuber stuff"
        icon="fa6-brands:bluesky"
        customAccent="0, 133, 255"
        customAccentLight="189,223,255"
        activityLevel={ActivityLevel.Low}
      />
      <SocialCard
        href="https://u.snoyw.net/github"
        title="GitHub - @snowydqys"
        body="i sometimes store some of my projects and stuff here"
        icon="fa6-brands:github"
        customAccent="23,21,21"
        customAccentLight="177,169,169"
        activityLevel={ActivityLevel.Low}
      />
      <SocialCard
        href="https://u.snoyw.net/twitch"
        title="Twitch - @snowydqys"
        body="i watch vtubers on rare occasions here. i mostly watch vtubers on youtube because twitch is bad"
        icon="fa6-brands:twitch"
        customAccent="145,70,255"
        customAccentLight="203,168,255"
        activityLevel={ActivityLevel.Low}
      />
      <SocialCard
        href="https://u.snoyw.net/kitsu"
        title="Kitsu - @snowydqys"
        body="backup of my anime list (automated)."
        icon="simple-icons:kitsu"
        customAccent="2,169,255"
        customAccentLight="200,245,255"
        activityLevel={ActivityLevel.Low}
      />
      <SocialCard
        href="https://u.snoyw.net/mal"
        title="MyAnimeList - @snowydqys"
        body="backup to the backup of my anime list (automated)."
        icon="simple-icons:myanimelist"
        customAccent="2,169,255"
        customAccentLight="200,245,255"
        activityLevel={ActivityLevel.Low}
      />
    </ul>
  </main>
</Layout>

<script>
  let susified = false;

  const susify = () => {
    if (!susified) {
      const audio = new Audio("https://cdn.snoyw.net/snoyw.net/sus.mp3");
      audio.play();

      susified = true;

      const snows = document.querySelectorAll(
        ".snow",
      ) as NodeListOf<HTMLElement>;

      snows.forEach((snow) => {
        snow.style.background = `url("https://cdn.snoyw.net/snoyw.net/sus.svg")`;
      });

      const snowWrapper = document.querySelector(
        ".snow-wrapper",
      ) as HTMLElement;

      snowWrapper.style.filter = "drop-shadow(0 0 10px #f00000)";

      const subHeading = document.getElementById("sub-heading") as HTMLElement;
      subHeading.innerText = "The Impostor";

      const mainText = document.getElementById("main-text") as HTMLElement;
      mainText.innerText =
        "WHEN THE IMPOSTOR IS SUS\nWHEN THE IMPOSTOR IS SUS\nWHEN THE IMPOSTOR IS SUS\nWHEN THE IMPOSTOR IS SUS";

      const avatar = document.querySelector(".avatar") as HTMLElement;
      avatar.classList.add("avatar-sus");
      avatar.classList.remove("avatar");
    } else {
      const audio = new Audio("https://cdn.snoyw.net/snoyw.net/amongus.mp3");
      audio.volume = 0.5;
      audio.play();
    }
  };

  let sequenceStep = 0;
  let sequenceRequired = [
    "ArrowUp",
    "ArrowUp",
    "ArrowDown",
    "ArrowDown",
    "ArrowLeft",
    "ArrowRight",
    "ArrowLeft",
    "ArrowRight",
    "b",
    "a",
  ];

  document.addEventListener("keydown", (e) => {
    if (e.key === sequenceRequired[sequenceStep]) {
      sequenceStep++;

      if (sequenceStep === sequenceRequired.length) {
        susify();
        sequenceStep = 0;
      }
    } else {
      sequenceStep = 0;
    }
  });
</script>

<script>
  const pools: HTMLAudioElement[][] = Array.from({ length: 5 }, () => []);

  function BAUBAU() {
    const i = Math.floor(Math.random() * 5);
    const pool = pools[i];
    let audio = pool.find((a) => a.paused || a.ended);

    if (!audio) {
      audio = pool.length < 4
        ? new Audio(`https://cdn.snoyw.net/snoyw.net/baubau/bau-0${i + 1}.mp3`)
        : pool.shift()!;
      pool.push(audio);
    }

    audio.playbackRate = 2 ** ((Math.random() * 2 - 1) / 12);
    audio.preservesPitch = false;
    audio.volume = 0.8 + Math.random() * 0.2;
    if (audio.readyState > 0) audio.currentTime = 0;
    audio.play().catch(() => {});
  }

  for (const baubautext of document.querySelectorAll(".bau-bau")) {
    baubautext.addEventListener("click", BAUBAU);
  }
</script>

<style lang="scss">
  .avatar {
    border: 2px solid transparent;
    border-radius: 100%;
    // background: linear-gradient(0deg, rgb(189, 218, 233), #85d4ff) border-box;
  }

  .avatar-sus {
    border: 2px solid transparent;
    border-radius: 100%;
    background: linear-gradient(0deg, #ff0000, #ffafaf) border-box;
  }

  .fuwamoco-text {
    /* text gradient */
    background: linear-gradient(
      45deg,
      rgba(86, 180, 254, 1) 0%,
      rgba(171, 169, 226, 1) 50%,
      rgba(255, 157, 198, 1) 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .fuwamoco-underline {
    /* underline gradient */
    position: relative;
    &::before {
      content: "";
      position: absolute;
      top: 95%;
      width: 100%;
      left: 0;
      height: 1px;
      background: linear-gradient(
        45deg,
        rgba(86, 180, 254, 1) 0%,
        rgba(171, 169, 226, 1) 50%,
        rgba(255, 157, 198, 1) 100%
      );
    }
  }

  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }

  .animate-wiggle {
    animation: wiggle 1s ease-in-out infinite;
  }

  .oshi-scroller {
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 2rem,
      black calc(100% - 2rem),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 2rem,
      black calc(100% - 2rem),
      transparent 100%
    );

    &:hover .oshi-group {
      animation-play-state: paused;
    }
  }

  .oshi-group {
    animation: oshi-scroll 15s linear infinite;
    will-change: transform;
  }

  @keyframes oshi-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oshi-group {
      animation: none;
    }
  }
</style>
